stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

blkmapcmd=blkmap create root;
	  blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}

preboot=run blkmapcmd

bootdelay=0
bootcmd=pstore set 0x46e00000 0x8000 0x0 0x4000 0x0 0x4000; pstore display console;
	run emmcbootcmd; run fastbootcmd

extlinux_part=mmc 0:13
emmcbootcmd=echo "Booting from eMMC (hold Volume Down at power-on for the menu)";
	sysboot ${extlinux_part} any ${scriptaddr} /boot/extlinux/extlinux.conf
emmcprevcmd=echo "Booting the previous kernel from eMMC";
	sysboot ${extlinux_part} any ${scriptaddr} /boot/extlinux/extlinux-prev.conf

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

bootmenu_0=Boot Kernel From eMMC=run emmcbootcmd; run fastbootcmd
bootmenu_1=Boot Previous Kernel=run emmcprevcmd; run fastbootcmd
bootmenu_2=Enter Fastboot Mode=run fastbootcmd
bootmenu_3=Reboot=reset
bootmenu_4=Power Off=poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=bootmenu
