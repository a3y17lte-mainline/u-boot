# Local safety fragment for agent use (not for upstream).
# USB download mode may only load images into RAM, never write the eMMC.
# No EFI firmware capsule updates.
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set
# CONFIG_EFI_CAPSULE_ON_DISK_EARLY is not set
# CONFIG_EFI_CAPSULE_FIRMWARE_RAW is not set
CONFIG_CMD_PSTORE=y
CONFIG_CMD_PSTORE_MEM_ADDR=0x46e00000
CONFIG_CMD_PSTORE_MEM_SIZE=0x8000
CONFIG_CMD_PSTORE_RECORD_SIZE=0x0
CONFIG_CMD_PSTORE_CONSOLE_SIZE=0x4000
CONFIG_CMD_PSTORE_FTRACE_SIZE=0x0
CONFIG_CMD_PSTORE_PMSG_SIZE=0x4000
CONFIG_CMD_PSTORE_ECC_SIZE=0
# Boot the kernel from /boot on SYSTEM (extlinux), read-only: no eMMC or FAT writes.
CONFIG_CMD_SYSBOOT=y
CONFIG_SUPPORT_RAW_INITRD=y
# CONFIG_MMC_WRITE is not set
# CONFIG_FAT_WRITE is not set
